<?xml version="1.0" encoding="UTF-8"?>
<!--
  TwiML Bin: Outgoing Calls
  
  SETUP:
  1. Go to Twilio Console > TwiML Bins
  2. Create a new TwiML Bin with a friendly name (e.g., "Outgoing Call Handler")
  3. Paste this XML content
  4. IMPORTANT: Replace +1XXXXXXXXXX with your Twilio phone number
  5. Save and copy the TwiML Bin URL
  6. Go to your TwiML App and set Voice Request URL to this TwiML Bin URL
  
  The {{To}} parameter is automatically populated by the Twilio Voice SDK
  when making outgoing calls.
-->
<Response>
  <Dial callerId="+1XXXXXXXXXX">
    <Number>{{To}}</Number>
  </Dial>
</Response>
